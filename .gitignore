# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Compiled Go binaries in topic folders (without extension)
# These are created when running `go build filename.go`
[0-9][0-9]-*/hello
[0-9][0-9]-*/variables
[0-9][0-9]-*/main

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

# Build output
/bin/
/dist/

# IDE specific files
.vscode/
.idea/
*.swp
*.swo
*~

# OS specific files
.DS_Store
Thumbs.db

# Temporary files
/tmp/
*.tmp
